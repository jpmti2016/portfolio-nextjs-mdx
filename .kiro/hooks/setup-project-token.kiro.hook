{
  "enabled": true,
  "name": "Set up PROJECT_TOKEN",
  "description": "Manually triggered from the Agent Hooks panel. Sets up the PROJECT_TOKEN repo secret so the spec-sync and add-issue workflows can run in full status mode (Todo → In Progress → Done), and checks that the repo's open issues are in Project #2.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run ~/.kiro/scripts/setup-project-token.sh to set up the PROJECT_TOKEN secret for this repo. First run it with no arguments to report whether the secret already exists and to print the PAT creation steps. Creating the PAT requires the user's interactive GitHub login + 2FA, so the script cannot mint it. Project #2 is owned by the USER jpmti2016, and fine-grained PATs do not offer a \"Projects\" permission for user-owned ProjectsV2 — so guide the user to create a CLASSIC PAT at https://github.com/settings/tokens/new with the \"project\" scope (Full control of projects, ~90-day expiry). When the user pastes the token, run the script again with --token <TOKEN> to verify and store it, and offer --add-missing to add any open issues that aren't yet in Project #2. Surface any errors (gh not authenticated, token can't read the project, etc.) and suggest the fix. Never echo the token value back to the user."
  }
}
